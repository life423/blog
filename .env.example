PORT=3188
# Local sample articles are never inserted into Azure automatically.
DESIGN_PREVIEW=true
# Run node scripts/setup-admin.js to create a username and hashed password in .env.
# Azure storage uses your CLI identity locally; no connection string.
# AZURE_STORAGE_ACCOUNT=drewblogdata
# Production: NODE_ENV=production, DESIGN_PREVIEW=false
# ADMIN_USERNAME, ADMIN_PASSWORD_HASH and ADMIN_SESSION_SECRET come from setup.
# Store ADMIN_PASSWORD_HASH and ADMIN_SESSION_SECRET as Container App secrets.
# PUBLIC_ORIGIN=https://blog.drewclark.io
# Optional alternative: TRUST_AZURE_AUTH=true + ADMIN_OBJECT_ID, only behind Easy Auth.
